[Unit]
Description=Traffic Analyzer
After=packet-sniffer.service

[Service]
Type=oneshot
EnvironmentFile=/opt/implant/config.env
ExecCondition=/bin/bash -c 'ip link show "$BRIDGE" >/dev/null 2>&1'
ExecStart=/usr/bin/python3 /opt/implant/scripts/traffic-analyzer.py
StandardOutput=journal
StandardError=journal
