{
    // ─── OpenClaw Configuration for PhantomPi VPS ───
    // Copy to ~/.openclaw/openclaw.json and fill in values.
    // Tokens should be set in ~/.openclaw/.env instead.

    "channels": {
        "discord": {
            "enabled": true,
            "token": {
                "source": "env",
                "provider": "default",
                "id": "DISCORD_BOT_TOKEN"
            },
            "dmPolicy": "allowlist",
            "groupPolicy": "allowlist",
            "guilds": {
                "__GUILD_ID__": {
                    "requireMention": false,
                    "users": ["__ADMIN_USER_ID__"],
                    "channels": {
                        "__ALERT_CHANNEL_NAME__": {
                            "allow": true,
                            "requireMention": false
                        },
                        "__CHAT_CHANNEL_NAME__": {
                            "allow": true,
                            "requireMention": false
                        }
                    }
                }
            },
            "dm": {
                "enabled": true,
                "allowFrom": ["__ADMIN_USER_ID__"]
            },
            "historyLimit": 30,
            "streaming": "off",
            "textChunkLimit": 2000
        }
    },

    "agents": {
        "defaults": {
            "model": "anthropic/claude-sonnet-4-6",
            "skills": ["cred-sniffer", "implant-status"]
        }
    },

    "cron": {
        "enabled": true,
        "maxConcurrentRuns": 1
    },

    "skills": {
        "load": {
            "extraDirs": ["/opt/openclaw/skills"]
        }
    }
}
