# ─── OpenClaw Environment Variables ───
# Copy to ~/.openclaw/.env and fill in values.

# OpenAI API key (required for the configured OpenAI model)
OPENAI_API_KEY=

# Discord bot token (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=

# Implant IPs on the WireGuard network (comma-separated for multiple)
IMPLANT_IPS=10.8.0.3

# Gateway authentication token (required when binding outside loopback)
OPENCLAW_GATEWAY_TOKEN=
